<%= render "shared/navbar" %>

<div class="country-dropdown">
  <select id="country-select" class="form-select" aria-label="Default select example">
    <option value="" disabled selected hidden>Country List</option>
        <% @countries.each do |country| %>
    <option value="<%= country.id %>"><%= country.name %></option>
        <% end%>
  </select>
  <div class="party-radio-selection" id="party-radio-selection">
    <div class="form-check">
      <input class="form-check-input"
            type="radio"
            name="party-radio-selection"
            value="Far Left"
            id="rulingPartyRadio1">
      <label class="far-left-label">Far Left</label>
    </div>
    <div class="form-check">
      <input class="form-check-input"
            type="radio"
            name="party-radio-selection"
            value="Centre Left"
            id="rulingPartyRadio2">
      <label class="centre-left-label">Centre Left</label>
    </div>
    <div class="form-check">
      <input class="form-check-input"
            type="radio"
            name="party-radio-selection"
            value="Centre"
            id="rulingPartyRadio3">
      <label class="centre-label">Centre</label>
    </div>
    <div class="form-check">
      <input class="form-check-input"
            type="radio"
            name="party-radio-selection"
            value="Centre Right"
            id="rulingPartyRadio4">
      <label class="centre-right-label">Centre Right</label>
    </div>
    <div class="form-check">
      <input class="form-check-input"
            type="radio"
            name="party-radio-selection"
            value="Far Right"
            id="rulingPartyRadio5">
      <label class="far-right-label">Far Right</label>
    </div>
  </div>
  <div class="edit-country-form">
    <input type="hidden" id="countryIdInput">
    <div class="country-input-field government-structure-input">
      <label for="governmentInput" class="form-label">Government Structure</label>
    <textarea type="text" class="form-control" id="governmentInput"></textarea>
    </div>
       <div class="country-input-field electoral-system-input">
        <label for="electoralInput" class="form-label">Electoral System</label>
    <textarea type="text" class="form-control" id="electoralInput"></textarea>
    </div>
       <div class="country-input-field political-parties-input">
        <label for="partiesInput" class="form-label">Political Parties</label>
    <textarea type="text" class="form-control" id="partiesInput"></textarea>
    </div>
       <div class="country-input-field eu-alignment-input">
        <label for="euInput" class="form-label">EU Alignment</label>
    <textarea type="text" class="form-control" id="euInput"></textarea>
    </div>
       <div class="country-input-field governance-indicators-input">
        <label for="indicatorsInput" class="form-label">Governance Indicators</label>
    <textarea type="text" class="form-control" id="indicatorsInput"></textarea>
    </div>
       <div class="country-input-field key-issues-input">
        <label for="issuesInput" class="form-label">Key Issues</label>
    <textarea type="text" class="form-control" id="issuesInput"></textarea>
    </div>
    <button type="button" id="saveCountryBtn" class="btn btn-primary">SAVE</button>
    <p id="lastUpdated"></p>

  </div>
</div>
