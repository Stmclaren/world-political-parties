<%= render "shared/navbar" %>

<div class="print-list">
  <ol class="list-group">
    <ol class="list-group-item">
      <input class="accordion-item"
             type="checkbox"
             value=""
             id="firstCheckbox">
      <label class="accordion-item collapsed">Africa</label>
      <button class="btn-primary btn" id="continent-expand"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#country-list-africa"
              aria-expanded="false"
              aria-controls="country-list-africa">Expand</button>
      <div id="country-list-africa" class="collapse">
        <% @countries.each do |country| %>
          <% if country.continent == "Africa" %>
        <li>
          <input class="form-check-input" type="checkbox" id="print-info <% country.name %>">
          <label for="print-info<% country.name %>" class="form-check-label"><%= country.name %></label>
        </li>
          <% end %>
        <% end %>
      </div>
    </ol>
    <ol class="list-group-item">
