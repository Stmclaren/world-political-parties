<%= render "shared/navbar" %>

<div class="print-list">
  <ol class="list-group" id="print-select-form">
    <ol class="list-group-item">
      <input class="accordion-item continent-checkbox"
             type="checkbox"
             value=""
             id="checkbox-africa"
             data-target-collapse="#country-list-africa">
      <label class="accordion-item collapsed" for="checkbox-africa">Africa</label>
      <button class="btn-primary btn" id="continent-expand"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#country-list-africa"
              aria-expanded="false"
              aria-controls="country-list-africa">Expand</button>
      <div id="country-list-africa" class="collapse">
        <ul class="list-unstyled ps-3 mt-2">
          <% @countries.each do |country| %>
            <% if country.continent == "Africa" %>
              <% country_id = "country-#{country.name.parameterize}" %>
              <li>
                <input class="country-checkbox form-check-input"
                      type="checkbox"
                      name="country_ids[]"
                      value="<%= country.id %>"
                      id="<%= country.id %>">
                <label for="<%= country.id %>" class="form-check-label">
                  <%= country.name %>
                </label>
              </li>
            <% end %>
          <% end %>
        </ul>
      </div>
    </ol>
