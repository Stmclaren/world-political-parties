<%# <nav class="navbar no-print"> %>
  <%= render "shared/navbar", print_preview: true %>
<%# </nav> %>

<div class="country-print-container" id="print-preview-container">
  <div class="print-header">
    <% @countries.each do |country| %>
    <h2 class="print-country-name">
      <%= country.name %>
    </h2>
    <img
      class="country-flag"
      id="flag-select"
      width="24px"
      data-iso="<%= country.iso %>"
      alt="<%= country.name %> flag">
    <p class="iso-header">
      <%= country.iso %>
    </p>
  </div>
  <dl class="print-content row">
    <dt class="col-sm-3">Ruling Party</dt>
    <dd class="col-sm-9">
      <P><%= country.ruling_party %></p>
    </dd>
    <dt class="col-sm-3">Government Structure</dt>
    <dd class="col-sm-9">
      <P><%= country.government_structure %></p>
    </dd>
    <dt class="col-sm-3">Electoral System</dt>
    <dd class="col-sm-9">
      <P><%= country.electoral_system %></p>
    </dd>
    <dt class="col-sm-3">Political Parties</dt>
    <dd class="col-sm-9">
      <P><%= country.political_parties %></p>
    </dd>
    <dt class="col-sm-3">EU Alignment</dt>
    <dd class="col-sm-9">
      <P><%= country.eu_alignment %></p>
    </dd>
    <dt class="col-sm-3">Governance Indicators</dt>
    <dd class="col-sm-9">
      <P><%= country.governance_indicators %></p>
    </dd>
    <dt class="col-sm-3">Key Issues</dt>
    <dd class="col-sm-9">
      <P><%= country.key_issues %></p>
    </dd>
  </dl>
  <% end %>
</div>
