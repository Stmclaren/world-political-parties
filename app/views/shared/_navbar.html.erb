<div class="dual-navbar">
  <div class="dropdown">
    <button class="navbar-brand dropdown-toggle"
      type="button"
      data-bs-toggle="dropdown">
      <%= image_tag "W-logo.png", class: "brand-logo" %>
    </button>
      <ul class="dropdown-menu">
      <% if admin_signed_in? %>
        <li>
          <%= link_to "Dashboard", admin_dashboard_path, class: "dropdown-item" %>
        </li>
        <li>
          <%= link_to "World Map", root_path, class: "dropdown-item" %>
        <li>
          <%= link_to "Sign Out", destroy_admin_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %>
        </li>
        <% else %>
        <li>
          <%= link_to "Sign In", new_admin_session_path, class: "dropdown-item" %>
        </li>
      <% end %>
      </ul>
  </div>
  <div class="print-countries">
    <%= link_to "Print", countries_path, class: "btn btn-primary" %>
    </div>
  </div>
